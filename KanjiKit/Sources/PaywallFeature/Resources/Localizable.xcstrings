      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i 2.136 jōyō"
          }
        }
      }
    },
    "Couldn't load the plans.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare i piani."
          }
        }
      }
    },
    "Free for %lld days, then:": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per %lld giorni, poi:"
          }
        }
      }
    },
