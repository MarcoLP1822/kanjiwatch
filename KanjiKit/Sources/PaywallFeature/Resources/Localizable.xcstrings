      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensile"
          }
        }
      }
    },
    "Privacy Policy": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        }
      }
    },
    "Renews automatically until cancelled. Cancel anytime from your Apple account settings.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova automaticamente finché non disdici. Puoi disdire quando vuoi dalle impostazioni del tuo account Apple."
          }
        }
      }
    },
    "Restore purchases": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina acquisti"
          }
        }
      }
    },
    "Reviews that adapt to you": {
      "comment": "Primo vantaggio del paywall: il motore impara cosa farti rivedere. Niente 'intelligenza artificiale': non lo è e non serve che lo sia.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripassi che si adattano a te"
          }
        }
      }
    },
