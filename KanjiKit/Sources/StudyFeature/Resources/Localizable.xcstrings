{
  "sourceLanguage" : "en",
  "strings" : {
    "Done" : {
      "comment" : "Bottone principale: chiude il giro e aspetta la prossima notifica.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatto"
          }
        }
      }
    },
    "Kanji %@, meaning %@" : {
      "comment" : "Etichetta VoiceOver del glifo: carattere e significato.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanji %1$@, significato %2$@"
          }
        }
      }
    },
    "Next at %@" : {
      "comment" : "Schermata d'attesa, oggi. %@ è l'ora.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prossimo alle %@"
          }
        }
      }
    },
    "Next tomorrow at %@" : {
      "comment" : "Schermata d'attesa, domani. %@ è l'ora.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prossimo domani alle %@"
          }
        }
      }
    },
    "Notifications are off" : {
      "comment" : "Schermata d'attesa senza notifiche in arrivo.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifiche disattivate"
          }
        }
      }
    },
    "Now" : {
      "comment" : "Bottone principale sotto i kanji saltati: il primo si apre subito.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora"
          }
        }
      }
    },
    "One more now" : {
      "comment" : "Bottone secondario: un altro kanji subito, senza aspettare la notifica.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro adesso"
          }
        }
      }
    },
    "Schedule every %lld min" : {
      "comment" : "Bottone secondario sotto i kanji saltati: tornano come notifiche, uno per intervallo.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programmali ogni %lld min"
          }
        }
      }
    },
    "Schedule it in %lld min" : {
      "comment" : "Come «Schedule every %lld min», con un kanji saltato solo.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programmalo tra %lld min"
          }
        }
      }
    },
    "Tap for readings" : {
      "comment" : "Suggerimento sotto i tratti disegnati e hint VoiceOver.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per le letture"
          }
        }
      }
    },
    "Tap for stroke order" : {
      "comment" : "Suggerimento sotto il glifo e hint VoiceOver.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per l'ordine dei tratti"
          }
        }
      }
    },
    "That's all for now" : {
      "comment" : "Titolo della schermata d'attesa: il giro è chiuso, si può abbassare il polso.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ora è tutto"
          }
        }
      }
    },
    "That's all for today" : {
      "comment" : "Raggiunto il numero di kanji del giorno: titolo dell'attesa, e sotto Fatto al posto di «Un altro adesso».",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per oggi è tutto"
          }
        }
      }
    },
    "With Premium you can keep going whenever you like: find it in Settings." : {
      "comment" : "Attesa a giornata finita, solo senza Premium: col Premium «Un altro adesso» va oltre il limite.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Col Premium vai avanti quando vuoi: lo trovi in Impostazioni."
          }
        }
      }
    },
    "You skipped %lld kanji today. Want to see them now?" : {
      "comment" : "A giornata finita: i kanji di oggi arrivati con una notifica che non hai aperto.",
